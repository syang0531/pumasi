          }
        }
      }
    },
    "/api/v1/jobs": {
      "post": {
        "summary": "Submit a job",
        "tags": [
          "jobs"
        ],
        "responses": {
          "201": {
            "description": "Submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Same as `pumasi run`: a job.toml (field `job`, or a file named job.toml) and the files it names (fields `files`, with relative paths as file names). Large shared inputs go through the file store.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "job": {
                    "type": "string",
                    "description": "job.toml text"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  },
                  "account": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "integer"
                  },
                  "after": {
                    "type": "string",
                    "description": "Job ids that must succeed first, comma separated"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "summary": "A job and its tasks",
        "tags": [
          "jobs"
