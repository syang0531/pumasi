    "/api/v1/invites": {
      "post": {
        "summary": "Create a join ticket or a provider invite",
        "tags": [
          "nodes"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Without `account`: a ticket for the owner's own machines (default 24 h). With it: an invite for someone else's machine earning for that account (default 7 days).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account": {
                    "type": "string"
                  },
                  "ttl_secs": {
                    "type": "integer"
                  },
                  "uses": {
                    "type": "integer"
                  },
                  "allow_docker": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/op": {
      "post": {
        "summary": "Any admin call",
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "The JSON form of the protocol's `AdminOp`, e.g. `\"Status\"` or `{\"Drain\": {\"node\": \"mac-mini\"}}`; the answer is the matching `AdminResponse`. The control plane checks the ticket's role as for the CLI.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ticket": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Pumasi admin or access ticket"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "pumasi_session"
      }
    },
    "responses": {
      "Error": {
        "description": "The call failed; the message says why (e.g. the ticket's role does not allow it)",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          }
        }
      }
    }
  }
}
