            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Job id (hex, as `pumasi status` shows it)"
          }
        ]
      }
    },
    "/api/v1/jobs/{id}/outputs.zip": {
      "get": {
        "summary": "Every task's output files as a zip",
        "tags": [
          "jobs"
        ],
        "responses": {
          "200": {
            "description": "Zip archive",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Inline outputs and outputs kept in the file store, as `task-<index>/<path>`.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Job id (hex, as `pumasi status` shows it)"
          }
        ]
      }
    },
    "/api/v1/jobs/{id}/tasks/{index}/logs": {
      "get": {
        "summary": "A task's output from byte offsets",
        "tags": [
          "jobs"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Poll with `stdout_next` and `stderr_next` as the next offsets; when `attempt` changes the task started over and offsets restart at 0. `live` is false for microVM tasks, whose output comes when they end.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Job id (hex, as `pumasi status` shows it)"
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "attempt",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "stdout_from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "stderr_from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/v1/nodes/{node}/{action}": {
      "post": {
