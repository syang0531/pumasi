{
  "openapi": "3.1.0",
  "info": {
    "title": "Pumasi dashboard API",
    "version": "1",
    "description": "Served by `pumasi ui`. Every call is made with the caller's Pumasi ticket (admin, submitter or viewer), whose role the control plane enforces. Authenticate with `Authorization: Bearer <ticket>` (a `pumasiadmin...` admin or access ticket), or with a signed-in browser session plus the `X-Pumasi-CSRF` header on POST. Job ids are hex strings; CU amounts are integers in milli-CU, rates in micro-CU."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "ticket": []
    },
    {
      "session": []
    }
  ],
  "paths": {
    "/api/openapi.json": {
      "get": {
        "summary": "This document",
        "tags": [
          "meta"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/whoami": {
      "get": {
        "summary": "The ticket's name and role",
        "tags": [
          "cluster"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "summary": "Cluster status: nodes and jobs",
        "tags": [
          "cluster"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Submitters see only their account's jobs."
      }
    },
    "/api/v1/metrics": {
      "get": {
        "summary": "Node metrics and cluster counters",
        "tags": [
          "monitoring"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Every node's latest sample; with `node`, its time series over `since` seconds (step_secs: 10 up to 1 h, 60 up to 24 h, 600 beyond).",
        "parameters": [
          {
            "name": "node",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Node name or id prefix"
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Seconds of history"
          }
        ]
      }
    },
    "/api/v1/events": {
      "get": {
        "summary": "Cluster events, oldest first",
        "tags": [
          "monitoring"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        },
        "description": "Cursor-based: pass the last `seq` you saw as `after`. With `after` 0, the newest `limit`.",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Not older than this Unix time"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Default 100"
          }
        ]
      }
    },
    "/api/v1/alerts": {
      "get": {
